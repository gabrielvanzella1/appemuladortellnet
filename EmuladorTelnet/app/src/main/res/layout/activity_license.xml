<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary" />

    <!-- ===== TELA 1: NÃO ATIVADO ===== -->
    <LinearLayout
        android:id="@+id/screen_not_activated"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ainda não possui uma licença?"
            android:textSize="18sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solicite uma licença trial gratuita por 30 dias"
            android:textSize="15sp"
            android:textColor="#777777"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-mail: scante@scante.com.br"
            android:textSize="15sp"
            android:textColor="@color/brand_green"
            android:gravity="center"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== TELA 2: FORMULÁRIO DE ATIVAÇÃO ===== -->
    <LinearLayout
        android:id="@+id/screen_form"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Digite sua chave de ativação. Se precisar de ajuda, consulte a seção AJUDA para mais informações."
            android:textSize="14sp"
            android:textColor="#777777"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chave de ativação"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/input_license_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SCTE-XXXXXX-XXXXXX-XXXXXX"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:textSize="15sp"
            android:textColor="#212121"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome de identificação"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/input_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: número de série do dispositivo"
            android:inputType="text"
            android:textSize="15sp"
            android:textColor="#212121"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btn_ativar_agora"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ATIVAR AGORA"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#212121"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/brand_green"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_activation_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ===== TELA 3: AJUDA ===== -->
    <ScrollView
        android:id="@+id/screen_help"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ATIVAÇÃO"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chave de Ativação"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Este aplicativo ScanTE requer uma chave de ativação para funcionar. Se você possui uma chave, insira-a para ativar o ScanTE.\n\nSe você recebeu o código por e-mail, copie-o para a área de transferência e cole no campo de chave de ativação."
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome de ativação"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Insira um nome para identificar este dispositivo. Recomendamos que você use o número de série do dispositivo, pois ele é permanente e resiste tanto à restauração de fábrica quanto à substituição da placa-mãe.\n\nAo inserir um nome exclusivo, você poderá solicitar a liberação de uma nova licença caso seu dispositivo quebre ou passe por uma restauração de fábrica."
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="24dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Adquirir o ScanTE"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Para adquirir uma licença do ScanTE, entre em contato conosco:"
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="www.scante.com.br"
                android:textSize="13sp"
                android:textColor="@color/brand_green"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="scante@scante.com.br"
                android:textSize="13sp"
                android:textColor="@color/brand_green"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
