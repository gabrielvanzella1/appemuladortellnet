<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:title="ScanTE não está ativado"
            app:titleTextColor="@android:color/white">

            <TextView
                android:id="@+id/btn_activate_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:text="Clique Aqui\npara Ativar"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="end"
                android:lineSpacingExtra="1dp"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true" />

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Conteudo -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ainda não possui uma licença?"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Solicite uma licença trial gratuita por 30 dias"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tv_email_trial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="E-mail: scante@scante.com.br"
                android:textSize="15sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:gravity="center"
                android:autoLink="email"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp" />

        </LinearLayout>

    </ScrollView>

    <!-- ===== PAINEL DEBUG (oculto em produção) ===== -->
    <LinearLayout
        android:id="@+id/debug_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A2A1A"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛠 DEBUG — Licença"
            android:textSize="11sp"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Liberar provisorio (bypass de teste) -->
        <Button
            android:id="@+id/btn_debug_unlock"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="LIBERAR (bypass de teste)"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00A651" />

    </LinearLayout>

</LinearLayout>
